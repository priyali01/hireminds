NODE_ENV=development
PORT=3001

# MongoDB — get a free cluster at mongodb.com/atlas
MONGODB_URI=mongodb://127.0.0.1:27017/hireminds

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_THIS
JWT_REFRESH_SECRET=GENERATE_THIS_DIFFERENT

# AI — get from aistudio.google.com
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Client URL (for CORS and the GitHub return redirect)
CLIENT_URL=http://localhost:5173

# GitHub App — create at github.com/settings/apps/new
# App name: HireMinds (or your own name)
# Homepage URL: http://localhost:5173 in local development, or the production site URL
# Setup URL (where GitHub returns after install):
#   local:      http://localhost:3001/optimize/github/callback
#   production: https://YOUR_API_HOST/optimize/github/callback
# Expire user authorization tokens: leave the default. HirMind uses installation tokens.
# Request user authorization (OAuth) during installation: off. The setup URL is enough.
# Webhook: off unless you add one later. Webhook secret is not read by this app.
# Repository permissions, read-only:
#   Metadata: Read
#   Contents: Read
# Do not grant write, administration, or account permissions.
# Installation: only the repositories the user selects.
# After creating the app, download the private key and copy the App ID and the URL slug.
# The live GitHub screen is not verified until these three values are set on the server.
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-app-slug
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nPASTE_THE_KEY_WITH_LITERAL_BACKSLASH_N_FOR_NEWLINES\n-----END RSA PRIVATE KEY-----"

# --- Optional (Phase 2+) ---
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
RESEND_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
